{"models":["mv7plus"],"modes":["fake"],"scenario":"mv7plus-mute-button-firmware","size":[120,40]}
{"device": {"firmware": "1.3.0.13", "unanswered_get": "MUTE_BUTTON"}}
{"key": "r"}
{"expect": {"get": "MUTE_BUTTON", "status": "State refreshed from device.", "status_is_error": false, "state": {"firmware_version": "1.3.0.13", "mute_btn_available": false}}}
{"key": "Tab", "repeat": 2}
