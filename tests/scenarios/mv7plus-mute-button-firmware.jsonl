{"key": "r"}
{"expect": {"status": "optional setting", "screen_contains": ["Pressing it: Unknown", "Unavailable"], "screen_not_contains": "Needs firmware", "state": {"firmware_version": "1.4.0", "mute_btn_available": false}}}
{"key": "Enter"}
{"expect": {"no_packets": true, "status_is_error": true, "status": "Mute Button unavailable"}}
{"device": {"firmware": "1.6.0.1"}}
{"key": "r"}
{"expect": {"status": "optional setting", "screen_contains": "Pressing it: Unknown", "screen_not_contains": "Needs firmware"}}
{"device": {"firmware": "Unknown"}}
{"key": "r"}
{"expect": {"status": "optional setting", "screen_contains": "Pressing it: Unknown", "screen_not_contains": "Needs firmware", "state": {"firmware_version": "Unknown"}}}
