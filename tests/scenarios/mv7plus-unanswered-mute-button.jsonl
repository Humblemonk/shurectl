{"models":["mv7plus"],"modes":["fake"],"scenario":"mv7plus-unanswered-mute-button","size":[120,40]}
{"device": {"unanswered_get": "MUTE_BUTTON"}}
{"key": "r"}
{"expect": {"state": {"mute_btn_available": false, "gain_tenths": 240}, "screen_contains": ["Mute Button", "Unknown"], "status": "optional setting", "connected": true}}
{"key": "Tab", "repeat": 2}
{"click_on": "Mute Button"}
{"key": "Enter"}
{"key": "Space"}
{"expect": {"no_packets": true, "status": "Mute Button unavailable", "status_is_error": true, "screen_contains": ["Pressing it: Unknown", "Unavailable"]}}
{"resize": [80, 24]}
{"expect": {"screen_contains": ["Pressing it: Unknown", "Unavailable"], "fits": true}}
{"click_on": "Denoiser"}
{"key": "Enter"}
{"expect": {"set": {"feature": "DENOISER", "value": true}, "state": {"denoiser_enabled": true}}}
{"key": "r"}
{"expect": {"state": {"denoiser_enabled": true, "mute_btn_available": false}, "status": "optional setting"}}
{"device": {"unanswered_get": null}}
{"key": "r"}
{"expect": {"state": {"mute_btn_available": true}, "screen_contains": "Pressing it: Works"}}
{"click_on": "Mute Button"}
{"key": "Enter"}
{"expect": {"set": {"feature": "MUTE_BUTTON", "value": true}, "state": {"mute_btn_disabled": true}}}
