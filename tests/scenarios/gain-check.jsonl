{"key": "g"}
{"key": "Esc"}
{"expect": {"status": "Gain check cancelled.", "screen_contains": "Summary"}}
{"key": "g"}
{"tick": 3000}
{"expect": {"screen_contains": "Time left     7 s"}}
{"key": "Down", "repeat": 2}
