{"key": "Enter"}
{"click": [2, 6]}
{"expect": {"confirming_factory_reset": false, "status": "Factory reset cancelled.", "no_packets": true}}
{"key": "Enter"}
{"key": "Enter"}
{"expect": {"set": "FACTORY_RESET", "status": "Factory reset sent"}}
