{"scenario": "factory-reset-needs-two-enters", "models": ["mv7plus", "mv6-gen2", "mvx2u-gen2"]}
{"key": "BackTab", "mods": "shift"}
{"key": "Down"}
{"expect": {"focus": "FactoryReset", "screen_contains": "Factory Reset"}}
{"key": "Enter"}
{"expect": {"confirming_factory_reset": true, "status_is_error": true, "no_packets": true}}
{"key": "Up"}
